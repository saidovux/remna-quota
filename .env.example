# Standalone API. Copy to .env; keep secrets out of version control.
# Generate independent keys with: go run ./cmd/quota-api keygen
BACKEND_API_KEY=
BACKEND_LISTEN_ADDR=127.0.0.1:8090
BACKEND_PUBLIC_URL=http://localhost:8090

# demo: ephemeral memory, no panel and no real VPN connections.
# remnawave: PostgreSQL + managed users, independent quotas and combined subscriptions.
BACKEND_PROVIDER=demo
BACKEND_DATABASE_URL=
BACKEND_SYNC_INTERVAL=10s
# Creates and synchronizes users via /api/v1/accounts. False permits read-only bundles only.
BACKEND_ENABLE_MANAGED_ACCOUNTS=true

# Production Compose requires a URL-safe password (keygen output is suitable).
# Compose constructs BACKEND_DATABASE_URL and sets BACKEND_PROVIDER=remnawave.
QUOTA_DB_PASSWORD=
BACKEND_PORT=8090

REMNAWAVE_BASE_URL=https://panel.example.com
REMNAWAVE_API_TOKEN=
# Optional dedicated External Squad with HWID enabled; assigned only to accounts
# with an explicitly configured device_limit. See docs/hwid.md.
REMNAWAVE_HWID_EXTERNAL_SQUAD_UUID=
REMNAWAVE_REQUEST_TIMEOUT=10s
# Replace example UUIDs with your MAIN/CDN internal squad UUIDs.
REMNAWAVE_PROFILES_JSON='{"main":["11111111-1111-4111-8111-111111111111"],"cdn":["22222222-2222-4222-8222-222222222222"]}'
# Enable HTTP only for a trusted private Docker network.
REMNAWAVE_ALLOW_HTTP=false
REMNAWAVE_CADDY_API_KEY=
REMNAWAVE_FORWARDED_FOR=
REMNAWAVE_FORWARDED_PROTO=
